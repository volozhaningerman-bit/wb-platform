generator client {
 provider="prisma-client-js"
}

datasource db {
 provider="postgresql"
 url=env("DATABASE_URL")
}

enum Role {
 USER
 ADMIN
 OWNER
}

enum Plan {
 FREE
 FULL
}

model User {
 id String @id @default(uuid())
 email String @unique
 passwordHash String
 name String?
 role Role @default(USER)

 workspaces WorkspaceMember[]
 sessions Session[]
}

model Session {
 id String @id @default(uuid())
 userId String
 tokenHash String
 user User @relation(fields:[userId],references:[id])
}

model Workspace {
 id String @id @default(uuid())
 name String

 members WorkspaceMember[]
 wbAccounts WBAccount[]
 plugins PluginInstall[]
 subscription Subscription?
}

model WorkspaceMember {
 id String @id @default(uuid())
 userId String
 workspaceId String

 user User @relation(fields:[userId],references:[id])
 workspace Workspace @relation(fields:[workspaceId],references:[id])
}

model WBAccount {
 id String @id @default(uuid())
 workspaceId String
 name String
 encryptedToken String

 workspace Workspace @relation(fields:[workspaceId],references:[id])
}

model Plugin {
 id String @id @default(uuid())
 code String @unique
 name String
}

model PluginInstall {
 id String @id @default(uuid())
 workspaceId String
 pluginId String
}

model Subscription {
 id String @id @default(uuid())
 workspaceId String
 plan Plan @default(FREE)
}

model SupportTicket {
 id String @id @default(uuid())
 title String
 message String
}
