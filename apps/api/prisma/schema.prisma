model User {
 id String @id
 email String @unique
 passwordHash String
 name String?
}

model Workspace {
 id String @id
 name String
 ownerId String
}

model WbAccount {
 id String @id
 name String
 token String
 workspaceId String
}

model Subscription {
 id String @id
 plan String
 workspaceId String
}
