model User {
 id String @id
 email String @unique
 passwordHash String
 role String
}

model Workspace {
 id String @id
 name String
 ownerId String
}

model WbAccount {
 id String @id
 name String
 token String
 connected Boolean
}

model Plugin {
 id String @id
 name String
}

model Subscription {
 id String @id
 plan String
 active Boolean
}

model SupportTicket {
 id String @id
 title String
 status String
}
